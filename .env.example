# Nous 环境变量模板
# 复制为 .env 并填入真实值: cp .env.example .env

# ── LLM ────────────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=sk-your-key-here

# ── 数据库 (可选, 默认 ~/nous-data/) ──────────────────────────────
# NOUS_DATA_DIR=~/nous-data

# ── 运行环境 ──────────────────────────────────────────────────────────
# NOUS_ENV=development
# NOUS_LOG_LEVEL=INFO
# NOUS_LOG_FORMAT=json

# ── 远程部署（可选，不要把真实主机写进仓库）──────────────────────────
# ECS_HOST=user@your-server
# ECS_SSH_KEY=~/.ssh/id_ed25519
# SYNC_API_URL=https://your-server/api/data/sync
# EYP_API_BASE=https://your-eyp-api
